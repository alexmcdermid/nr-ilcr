SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
LOG_LEVEL=INFO
ILCR_SECURITY_ENABLED=false

# Local Oracle dev DB. Keep real local credentials in ignored .env only.
# Leave ILCR_DATASOURCE_ENABLED=false for the in-memory scaffold.
# In Docker Compose, set ILCR_DATASOURCE_ENABLED=true to enable Oracle connectivity.
# For direct Maven runs, the oracle profile also enables the datasource.
ILCR_DATASOURCE_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//<host>:1521/<service-name>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# Mock submitter's directory GUID — security-off local dev only (ILCR_SECURITY_ENABLED=false).
# With security off there is no real sign-in; the backend presents a mock user instead. A mock
# ILCR_SUBMITTER is shown only the mills its GUID is ACTIVELY associated to in
# THE.ILCR_MILL_USER_XREF (INACTIVE_DATE IS NULL, ACTIVE_DATE IS NOT NULL), so the GUID has to be
# one the connected database actually knows. A mock ILCR_ADMIN sees every mill and ignores it.
#
# - Local seeded database: leave this commented out. The app default
#   (CANONSUBMITTERBBBBCCCCDDDD000001) is already associated to every mill by the test seed and by
#   frontend/e2e/real-test-data-patches/common/mock-submitter-associations.sql.
# - Ministry database: the default GUID has no associations there, so a mock submitter's Home mill
#   list is EMPTY. Set this to the GUID of a real submitter in that database. To find one:
#     SELECT USER_GUID, COUNT(*) AS MILLS FROM THE.ILCR_MILL_USER_XREF
#      WHERE INACTIVE_DATE IS NULL AND ACTIVE_DATE IS NOT NULL
#      GROUP BY USER_GUID ORDER BY MILLS DESC;
#   That is a real person's identifier: put it in ignored .env only, never commit it here.
#
# Has no effect with security on: a signed-in user's GUID comes from their FAM token instead.
ILCR_SECURITY_MOCK_USER_GUID=<32-char directory GUID of a submitter in the connected database> # comment out if you're using the local seeded database

# NR User Lookup API (DL-27) — the ministry directory behind the assignment picker.
# OFF everywhere until the service account is provisioned. The backend refuses to start with the
# flag on and any of the four values blank, so turn it on only once all of them are set.
# The client id/secret are a per-environment VAULT secret: put real values in ignored .env only,
# never here and never in application.yml.
ILCR_USER_LOOKUP_ENABLED=false
ILCR_USER_LOOKUP_BASE_URL=
ILCR_USER_LOOKUP_TOKEN_URL=
ILCR_USER_LOOKUP_CLIENT_ID=
ILCR_USER_LOOKUP_CLIENT_SECRET=

# Required for real CSS authentication (no new client secret).
ILCR_OIDC_ISSUER_URI=
ILCR_OIDC_CLIENT_ID=
